---
layout: layouts/base.njk
---
<h1>{{ title }}</h1>
{{ content | safe }}
<ul class="listing">
  {% for post in collections.posts %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <time datetime="{{ post.date.toISOString() }}">{{ post.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) }}</time>
    </li>
  {% endfor %}
</ul>
